# Copy this file to ".env" (same folder) and fill in your keys:
#   copy .example.env .env
# ".env" is git-ignored; never commit real keys.

# Ollama Cloud API key  ->  ollama.com > Settings > Keys
Ollam_api_key=

# Arize AX  ->  app.arize.com
# Space ID: in the browser URL after /spaces/  (or Settings > Space Settings)
ARIZE_SPACE_ID=
# API key: Settings > API Keys > create key
ARIZE_API_KEY=
